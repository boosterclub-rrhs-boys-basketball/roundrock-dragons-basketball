---
import { footerLinks, site } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="bg-primary text-primary-foreground font-system">
  <div class="max-w-[1800px] mx-auto px-4 sm:px-8 lg:px-12 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
      <div class="lg:col-span-2">
        <h3 class="font-semibold text-base mb-3">Quick Links</h3>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2">
          {
            footerLinks.map((link) => (
              <a
                href={link.href}
                class="text-primary-foreground/80 hover:text-secondary transition-colors py-1 text-sm"
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </div>

      <div>
        <h3 class="font-semibold text-base mb-3">Contact</h3>
        <div class="space-y-2 text-primary-foreground/80 text-sm">
          <div class="flex items-start gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-secondary mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
            <div>
              <div class="font-medium">{site.address.line1}</div>
              <div>{site.address.line2}</div>
              <div>
                {site.address.city}, {site.address.state} {site.address.zip}
              </div>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-secondary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92Z" />
            </svg>
            <a href={`tel:${site.phone.replace(/\D/g, "")}`} class="hover:text-secondary transition-colors">
              {site.phone}
            </a>
          </div>

          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-secondary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect width="20" height="16" x="2" y="4" rx="2" />
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
            </svg>
            <a href={`mailto:${site.email}`} class="hover:text-secondary transition-colors break-all">
              {site.email}
            </a>
          </div>
        </div>
      </div>

      <div>
        <h3 class="font-semibold text-base mb-3">Our Mission</h3>
        <p class="text-primary-foreground/80 mb-3 text-sm leading-relaxed">{site.mission}</p>
        <div class="flex gap-3">
          <a
            href={site.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="text-primary-foreground/80 hover:text-secondary transition-colors p-1"
            aria-label="Follow us on Facebook"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="border-t border-primary-foreground/20 mt-6 pt-4 space-y-3">
      <div class="text-center lg:text-left">
        <p class="text-primary-foreground/60 text-xs leading-relaxed">{site.disclaimer}</p>
      </div>
      <div class="flex flex-col sm:flex-row justify-between items-center text-xs text-primary-foreground/60 gap-2 sm:gap-0">
        <p>© {year} {site.address.line1}. All rights reserved.</p>
        <div class="flex gap-4">
          <a href="/privacy" class="hover:text-secondary transition-colors">Privacy Policy</a>
          <a href="/terms" class="hover:text-secondary transition-colors">Terms of Service</a>
        </div>
      </div>
    </div>
  </div>
</footer>
