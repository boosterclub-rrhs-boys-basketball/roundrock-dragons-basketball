---
import type { Coach } from "../data/coaches";
import SectionContainer from "./SectionContainer.astro";
import PrimaryButton from "./PrimaryButton.astro";

interface Props {
  coach: Coach;
}

const { coach } = Astro.props;
const bioParagraphs = coach.bio.split("\n\n");
const introParagraphs = bioParagraphs.slice(0, 2);
const closingParagraphs = bioParagraphs.slice(2);
---

<section class="py-8 bg-white">
  <SectionContainer>
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-start">
      <div>
        <h2 class="font-display text-3xl sm:text-4xl font-bold text-dragon-maroon">Meet Coach Levie</h2>

        <div class="mt-6 rounded-2xl overflow-hidden shadow-dramatic lg:hidden">
          <img
            src="/coach-levie.jpg"
            alt="Coach Travis Levie"
            class="w-full aspect-[4/5] object-cover object-top"
            loading="lazy"
          />
        </div>

        <div class="mt-6 text-muted-foreground space-y-4 leading-relaxed">
          {introParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        {
          coach.careerHighlights && (
            <div class="mt-6">
              <p class="font-semibold text-card-foreground">
                Over the past 17 years, he has served in multiple leadership roles:
              </p>
              <ul class="mt-3 space-y-2 text-muted-foreground list-disc list-inside">
                {coach.careerHighlights.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          )
        }

        <div class="mt-6 text-muted-foreground space-y-4 leading-relaxed">
          {closingParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <div class="mt-8">
          <PrimaryButton href="/coaches">Meet All Coaches</PrimaryButton>
        </div>
      </div>

      <div class="space-y-6 lg:sticky lg:top-24">
        <div class="hidden lg:block rounded-2xl overflow-hidden shadow-dramatic">
          <img
            src="/coach-levie.jpg"
            alt="Coach Travis Levie"
            class="w-full aspect-[4/5] object-cover object-top"
            loading="lazy"
          />
        </div>

        <div class="rounded-2xl bg-dragon-dark text-white p-8 shadow-dramatic">
          <h3 class="font-display text-2xl font-bold">{coach.name}</h3>
          <p class="text-dragon-gold font-semibold mt-1">{coach.title}</p>
          <p class="mt-4 text-white/80 text-sm leading-relaxed">{coach.credentials}</p>

          <div class="grid grid-cols-3 gap-4 mt-8">
            {
              coach.stats.map((stat) => (
                <div class="text-center">
                  <div class="font-display text-2xl font-bold">{stat.value}</div>
                  <div class="text-xs text-white/70 mt-1">{stat.label}</div>
                </div>
              ))
            }
          </div>

          {
            coach.quote && (
              <blockquote class="mt-8 border-l-4 border-dragon-gold pl-4 italic text-white/90 text-sm leading-relaxed">
                "{coach.quote}"
              </blockquote>
            )
          }
        </div>
      </div>
    </div>
  </SectionContainer>
</section>
