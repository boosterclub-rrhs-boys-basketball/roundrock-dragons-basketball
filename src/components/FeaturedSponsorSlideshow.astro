---
import type { Sponsor } from "../data/sponsors";
import { featuredSponsorBlurb, getTierStyle } from "../data/sponsors";

interface Props {
  sponsors: Sponsor[];
}

const { sponsors } = Astro.props;
const slideData = sponsors.map((sponsor) => ({
  ...sponsor,
  style: getTierStyle(sponsor.tier),
}));
---

{
  sponsors.length > 0 && (
    <div class="relative" data-sponsor-slideshow data-interval="5000">
      {
        sponsors.length > 1 && (
          <>
            <button
              type="button"
              class="absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 z-20 bg-white/90 hover:bg-white backdrop-blur-sm rounded-full p-3 transition-all duration-200 hover:scale-110 shadow-lg"
              data-slideshow-prev
              aria-label="Previous sponsor"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-dragon-maroon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M15 18l-6-6 6-6" />
              </svg>
            </button>
            <button
              type="button"
              class="absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 z-20 bg-white/90 hover:bg-white backdrop-blur-sm rounded-full p-3 transition-all duration-200 hover:scale-110 shadow-lg"
              data-slideshow-next
              aria-label="Next sponsor"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-dragon-maroon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M9 18l6-6-6-6" />
              </svg>
            </button>
          </>
        )
      }

      <div class="grid [&>*]:col-start-1 [&>*]:row-start-1 mb-6">
        {
          slideData.map((sponsor, index) => (
            <div
              class:list={[
                "rounded-3xl shadow-glow transition-opacity duration-500 ease-in-out",
                sponsor.style.cardBg,
                sponsor.style.text,
                index === 0 ? "opacity-100 z-10" : "opacity-0 z-0 pointer-events-none",
              ]}
              data-slideshow-slide
              data-index={index}
              aria-hidden={index !== 0}
            >
              <div class="absolute top-6 left-6 z-10">
                <span class="inline-flex items-center gap-1 rounded-md bg-white/95 text-dragon-maroon text-sm font-bold px-4 py-2 shadow-lg backdrop-blur-sm">
                  ⭐ Featured Partner
                </span>
              </div>

              <div class="flex flex-col items-center justify-center px-6 py-12 md:py-16">
                {
                  sponsor.logo && (
                    <div class="mb-6">
                      <div class="bg-white rounded-2xl p-6 md:p-10 shadow-2xl">
                        <img
                          src={sponsor.logo}
                          alt={sponsor.name}
                          class="h-32 w-64 sm:h-40 sm:w-80 md:h-48 md:w-96 object-contain mx-auto"
                          loading={index === 0 ? "eager" : "lazy"}
                        />
                      </div>
                    </div>
                  )
                }

                <div class="text-center max-w-3xl">
                  <span class:list={["inline-block mb-4 rounded-md px-4 py-1 text-sm font-semibold", sponsor.style.badge]}>
                    {sponsor.tier}
                  </span>
                  <h3 class="font-display text-3xl md:text-5xl font-bold mb-4 text-shadow">{sponsor.name}</h3>
                  <p class="text-lg md:text-xl opacity-90 mb-6 max-w-2xl mx-auto">{featuredSponsorBlurb}</p>
                  {
                    sponsor.website && (
                      <a
                        href={sponsor.website}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center justify-center gap-2 h-12 px-8 rounded-md bg-white text-dragon-maroon font-bold text-base shadow-lg hover:bg-white/90 transition-colors"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14 21 3" />
                        </svg>
                        Visit Their Website
                      </a>
                    )
                  }
                </div>
              </div>
            </div>
          ))
        }
      </div>

      {
        sponsors.length > 1 && (
          <div class="flex justify-center gap-2 mb-6" data-slideshow-dots>
            {sponsors.map((_, index) => (
              <button
                type="button"
                class:list={[
                  "w-3 h-3 rounded-full transition-all duration-200 hover:scale-110",
                  index === 0 ? "bg-dragon-maroon" : "bg-gray-300 hover:bg-gray-400",
                ]}
                data-slideshow-dot={index}
                aria-label={`Go to sponsor ${index + 1}`}
              />
            ))}
          </div>
        )
      }
    </div>
  )
}

<script>
  function initSponsorSlideshows() {
    document.querySelectorAll("[data-sponsor-slideshow]").forEach((root) => {
      if (root.dataset.slideshowReady === "true") return;
      root.dataset.slideshowReady = "true";

      const slides = Array.from(root.querySelectorAll("[data-slideshow-slide]"));
      const dots = Array.from(root.querySelectorAll("[data-slideshow-dot]"));
      const prev = root.querySelector("[data-slideshow-prev]");
      const next = root.querySelector("[data-slideshow-next]");
      const intervalMs = Number(root.dataset.interval || "5000");

      if (slides.length === 0) return;

      let index = 0;
      let timer;

      const show = (nextIndex) => {
        index = (nextIndex + slides.length) % slides.length;

        slides.forEach((slide, i) => {
          const active = i === index;
          slide.classList.toggle("opacity-100", active);
          slide.classList.toggle("z-10", active);
          slide.classList.toggle("pointer-events-none", !active);
          slide.classList.toggle("opacity-0", !active);
          slide.classList.toggle("z-0", !active);
          slide.setAttribute("aria-hidden", String(!active));
        });

        dots.forEach((dot, i) => {
          dot.classList.toggle("bg-dragon-maroon", i === index);
          dot.classList.toggle("bg-gray-300", i !== index);
        });
      };

      const restartTimer = () => {
        clearInterval(timer);
        if (slides.length > 1) {
          timer = setInterval(() => show(index + 1), intervalMs);
        }
      };

      prev?.addEventListener("click", () => {
        show(index - 1);
        restartTimer();
      });

      next?.addEventListener("click", () => {
        show(index + 1);
        restartTimer();
      });

      dots.forEach((dot) => {
        dot.addEventListener("click", () => {
          show(Number(dot.getAttribute("data-slideshow-dot")));
          restartTimer();
        });
      });

      root.addEventListener("mouseenter", () => clearInterval(timer));
      root.addEventListener("mouseleave", restartTimer);

      show(0);
      restartTimer();
    });
  }

  initSponsorSlideshows();
  document.addEventListener("astro:page-load", initSponsorSlideshows);
</script>
