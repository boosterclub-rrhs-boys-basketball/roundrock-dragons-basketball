---
interface Props {
  href: string;
  class?: string;
  external?: boolean;
}

const { href, class: className = "", external = false } = Astro.props;
const externalProps = external ? { target: "_blank", rel: "noopener noreferrer" } : {};
---

<a
  href={href}
  class:list={[
    "inline-flex items-center justify-center h-11 px-8 rounded-md border-2 border-dragon-maroon text-dragon-maroon font-bold text-sm transition-all duration-300 hover:bg-dragon-maroon/5 hover:scale-105",
    className,
  ]}
  {...externalProps}
>
  <slot />
</a>
