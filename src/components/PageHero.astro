---
interface Props {
  title: string;
  subtitle?: string;
  dark?: boolean;
}

const { title, subtitle, dark = false } = Astro.props;
---

<section class:list={["py-16 sm:py-20", dark ? "bg-dragon-maroon text-white" : "bg-white"]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h1 class="font-display text-4xl sm:text-5xl font-bold uppercase tracking-wide">{title}</h1>
    {subtitle && (
      <p class:list={["mt-4 text-lg max-w-2xl mx-auto", dark ? "text-white/90" : "text-gray-600"]}>
        {subtitle}
      </p>
    )}
  </div>
</section>
