---
import {
  sponsors,
  featuredSponsorStats,
  whySponsorItems,
  investmentStats,
  getFeaturedSponsors,
  getTierStyle,
} from "../data/sponsors";
import { site } from "../data/site";
import SectionContainer from "./SectionContainer.astro";
import FeaturedSponsorSlideshow from "./FeaturedSponsorSlideshow.astro";

const featuredSponsors = getFeaturedSponsors();
---

<section class="py-12 bg-gradient-to-br from-white to-muted">
  <SectionContainer>
    <div class="text-center mb-12">
      <h2 class="font-body text-3xl md:text-4xl font-bold text-foreground mb-4">Proud Partners</h2>
      <p class="font-body text-xl text-muted-foreground mb-6">Supporting Excellence in Youth Basketball</p>

      <FeaturedSponsorSlideshow sponsors={featuredSponsors} />
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-16 font-body">
      {
        featuredSponsorStats.map((stat) => (
          <div class="text-center">
            <div class="bg-primary/10 rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
              {
                stat.icon === "users" && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
                  </svg>
                )
              }
              {
                stat.icon === "trending" && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M22 7 13.5 15.5 8.5 10.5 2 17" />
                    <path d="M16 7h6v6" />
                  </svg>
                )
              }
              {
                stat.icon === "heart" && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
                  </svg>
                )
              }
              {
                stat.icon === "target" && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" />
                    <circle cx="12" cy="12" r="6" />
                    <circle cx="12" cy="12" r="2" />
                  </svg>
                )
              }
            </div>
            <div class="font-body text-3xl font-bold text-primary mb-2">{stat.value}</div>
            <div class="font-body text-muted-foreground">{stat.label}</div>
          </div>
        ))
      }
    </div>

    <div class="grid md:grid-cols-2 gap-8 mb-16 font-body">
      <div>
        <h3 class="text-2xl font-bold text-foreground mb-6">Why Sponsor the Dragons?</h3>
        <div class="space-y-4">
          {
            whySponsorItems.map((item) => (
              <div class="flex items-start gap-3">
                <div class="bg-primary/10 rounded-full p-2 shrink-0">
                  {
                    item.icon === "users" && (
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
                      </svg>
                    )
                  }
                  {
                    item.icon === "heart" && (
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
                      </svg>
                    )
                  }
                  {
                    item.icon === "target" && (
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="12" cy="12" r="10" />
                        <circle cx="12" cy="12" r="6" />
                        <circle cx="12" cy="12" r="2" />
                      </svg>
                    )
                  }
                </div>
                <div>
                  <p class="font-body font-semibold text-foreground mb-1">{item.title}</p>
                  <p class="font-body text-sm text-muted-foreground">{item.description}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div>
        <h3 class="text-2xl font-bold text-foreground mb-6">Your Investment Reaches</h3>
        <div class="bg-gradient-to-r from-primary/5 to-secondary/5 rounded-xl p-6">
          <div class="grid grid-cols-2 gap-6">
            {
              investmentStats.map((stat) => (
                <div class="text-center">
                  <div class="font-body text-2xl font-bold text-primary mb-1">{stat.value}</div>
                  <div class="font-body text-sm text-muted-foreground">{stat.label}</div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <div class="mb-16 font-body">
      <h3 class="text-2xl font-bold text-foreground text-center mb-8">Our Complete Sponsor Family</h3>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8">
        {
          sponsors.map((sponsor) => {
            const tierStyle = getTierStyle(sponsor.tier);
            return (
              <div class="rounded-xl bg-white border-0 shadow-elegant hover:shadow-glow transition-all duration-300 p-8 text-center">
                {
                  sponsor.logo ? (
                    <img
                      src={sponsor.logo}
                      alt={sponsor.name}
                      class="w-32 h-32 mx-auto rounded-lg object-contain mb-6"
                      loading="lazy"
                    />
                  ) : (
                    <div class="w-32 h-32 mx-auto rounded-lg bg-muted flex items-center justify-center mb-6">
                      <span class="text-2xl font-bold text-muted-foreground">{sponsor.name.charAt(0)}</span>
                    </div>
                  )
                }
                <p class="text-xl font-bold text-foreground text-center mb-3">{sponsor.name}</p>
                <span class:list={["inline-block rounded-md px-3 py-1 text-xs font-bold text-white", tierStyle.cardBg]}>
                  {sponsor.tier}
                </span>
              </div>
            );
          })
        }
      </div>
    </div>

    <div class="text-center bg-gradient-to-r from-primary to-secondary rounded-2xl p-8 text-primary-foreground">
      <p class="text-2xl md:text-3xl font-bold mb-4">Join the Winning Team</p>
      <p class="text-lg mb-8 opacity-90">
        Partner with the Dragons and watch your business grow while supporting youth athletics
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/sponsors"
          class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-semibold h-11 px-8 bg-white text-primary hover:bg-white/90 transition-colors"
        >
          View Sponsorship Packages
        </a>
        <a
          href={`mailto:${site.email}?subject=Sponsorship Inquiry`}
          class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-semibold h-11 px-8 bg-secondary text-secondary-foreground hover:bg-secondary/80 shadow-glow transition-all duration-300"
        >
          Contact Us Today
        </a>
      </div>
    </div>
  </SectionContainer>
</section>
