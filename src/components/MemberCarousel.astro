---
import type { Member } from "../data/members";
import Carousel from "./Carousel.astro";
import { getAvatarGradient, getInitials } from "../utils/avatar";

interface Props {
  members: Member[];
}

const { members } = Astro.props;

const tierStyles: Record<Member["tier"], { label: string; gradient: string }> = {
  Champion: { label: "Champion", gradient: "from-yellow-600 to-yellow-800" },
  Member: { label: "Member", gradient: "from-gray-600 to-gray-800" },
};
---

<section class="py-8 px-4 bg-gradient-to-br from-background via-background to-muted/20 font-sans">
  <div class="container mx-auto max-w-6xl">
    <div class="text-center mb-8">
      <h2
        class="text-3xl font-bold mb-3 bg-gradient-to-r from-primary via-primary to-accent bg-clip-text text-transparent"
      >
        Meet Our Dragons Family
      </h2>
      <p class="text-muted-foreground text-base max-w-2xl mx-auto">
        Hear from the incredible members who make our basketball program possible
      </p>
      <a
        href="/recognition"
        class="inline-flex items-center justify-center h-11 px-8 rounded-md border-2 border-primary bg-card text-primary font-semibold transition-all duration-300 hover:bg-primary hover:text-primary-foreground mt-4"
      >
        View All Members
      </a>
    </div>

    <Carousel id="members-carousel" class="w-full">
      {
        members.map((member) => {
          const tier = tierStyles[member.tier];
          return (
            <div class="p-2">
              <article class="rounded-lg border-2 border-border bg-card hover:shadow-lg transition-all duration-300 h-full">
                <div class="p-6 flex flex-col items-center text-center space-y-4">
                  <div
                    class="relative flex h-24 w-24 shrink-0 overflow-hidden rounded-full border-4 border-primary/20"
                  >
                    {
                      member.photo ? (
                        <img
                          src={member.photo}
                          alt={member.name}
                          class="aspect-square h-full w-full object-cover"
                          loading="lazy"
                        />
                      ) : (
                        <span
                          class="flex h-full w-full items-center justify-center text-2xl font-bold text-white"
                          style={{ background: getAvatarGradient(member.name) }}
                        >
                          {getInitials(member.name)}
                        </span>
                      )
                    }
                  </div>

                  <div class="space-y-2">
                    <h3 class="font-bold text-xl text-foreground">{member.name}</h3>
                    <span
                      class:list={[
                        "inline-flex items-center rounded-md px-2.5 py-0.5 text-xs font-semibold bg-gradient-to-r text-white border-0",
                        tier.gradient,
                      ]}
                    >
                      {tier.label}
                    </span>
                  </div>

                  <div class="relative w-full">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="absolute -top-2 -left-2 h-6 w-6 text-primary/20"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path d="M4.583 17.321C3.553 16.227 3 15 3 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311 1.804.167 3.226 1.648 3.226 3.489a3.5 3.5 0 0 1-3.5 3.5c-1.073 0-2.099-.49-2.748-1.179Zm10 0C13.553 16.227 13 15 13 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311 1.804.167 3.226 1.648 3.226 3.489a3.5 3.5 0 0 1-3.5 3.5c-1.073 0-2.099-.49-2.748-1.179Z" />
                    </svg>
                    <p class="text-muted-foreground italic pl-4 text-sm leading-relaxed line-clamp-4">
                      {member.quote}
                    </p>
                  </div>
                </div>
              </article>
            </div>
          );
        })
      }
    </Carousel>
  </div>
</section>
