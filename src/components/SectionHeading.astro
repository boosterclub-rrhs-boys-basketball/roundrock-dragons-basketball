---
interface Props {
  title: string;
  subtitle?: string;
  light?: boolean;
  /** sm = Upcoming Games (2xl/3xl), lg = Latest News (3xl/4xl) */
  size?: "sm" | "lg";
  class?: string;
}

const { title, subtitle, light = false, size = "lg", class: className = "" } = Astro.props;

const sizeClasses = {
  sm: "text-2xl md:text-3xl",
  lg: "text-3xl md:text-4xl",
};
---

<div class:list={["text-center mb-8", className]}>
  <h2
    class:list={[
      "font-sans font-bold mb-3",
      sizeClasses[size],
      light ? "text-primary-foreground" : "text-foreground",
    ]}
  >
    {title}
  </h2>
  {
    subtitle && (
      <p
        class:list={[
          "text-lg",
          light ? "text-primary-foreground/80" : "text-muted-foreground",
        ]}
      >
        {subtitle}
      </p>
    )
  }
</div>
