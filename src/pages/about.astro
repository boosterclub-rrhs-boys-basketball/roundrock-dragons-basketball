---
import BaseLayout from "../layouts/BaseLayout.astro";
import { aboutPage } from "../data/aboutPage";
import { site } from "../data/site";

const { hero, mission, stats, board, history, contact, contactDialog } = aboutPage;

const icons = {
  trophy: `<path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6" /><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18" /><path d="M4 22h16" /><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22" /><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22" /><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z" />`,
  users: `<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />`,
  heart: `<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />`,
  target: `<circle cx="12" cy="12" r="10" /><circle cx="12" cy="12" r="6" /><circle cx="12" cy="12" r="2" />`,
  mapPin: `<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" /><circle cx="12" cy="10" r="3" />`,
  mail: `<rect width="20" height="16" x="2" y="4" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />`,
  send: `<path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z" /><path d="m21.854 2.147-10.94 10.939" />`,
  usersBtn: `<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />`,
};
---

<BaseLayout title="About Us" description="About the Round Rock High School Boys Basketball Booster Club.">
  <div class="min-h-screen bg-background font-system">
    <section class="hero-gradient py-20">
      <div class="mx-auto max-w-[1800px] px-4 text-center sm:px-8 lg:px-12">
        <h1 class="mb-4 text-4xl font-bold text-primary-foreground text-shadow md:text-6xl">{hero.title}</h1>
        <p class="mx-auto max-w-3xl text-xl text-primary-foreground/90 text-shadow">{hero.subtitle}</p>
      </div>
    </section>

    <section class="py-16">
      <div class="mx-auto max-w-[1800px] px-4 sm:px-8 lg:px-12">
        <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
          <div>
            <h2 class="mb-6 text-3xl font-bold text-foreground md:text-4xl">{mission.title}</h2>
            <div class="mb-8 space-y-4 text-lg text-muted-foreground">
              {mission.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
            <div class="flex flex-col gap-4 sm:flex-row">
              <a
                href={mission.joinHref}
                class="inline-flex h-10 items-center justify-center rounded-md border-2 border-primary bg-card px-4 py-2 text-sm font-semibold text-primary transition-all duration-300 hover:bg-primary hover:text-primary-foreground"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={icons.usersBtn} />
                {mission.joinLabel}
              </a>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-6">
            {stats.map((stat) => (
              <article class="rounded-lg border bg-card p-6 text-center text-card-foreground shadow-sm">
                <div class="mb-4 flex justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto h-12 w-12 text-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={icons[stat.icon]} />
                </div>
                <h3 class="mb-2 text-2xl font-bold text-foreground">{stat.value}</h3>
                <p class="text-muted-foreground">{stat.label}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="board" class="bg-muted py-16">
      <div class="mx-auto max-w-[1800px] px-4 sm:px-8 lg:px-12">
        <div class="mb-12 text-center">
          <h2 class="mb-4 text-3xl font-bold text-foreground md:text-4xl">{board.title}</h2>
          <p class="text-xl text-muted-foreground">{board.subtitle}</p>
        </div>

        <div class="mx-auto grid max-w-6xl grid-cols-1 justify-items-center gap-6 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
          {board.members.map((member) => (
            <article class="rounded-lg border bg-card text-card-foreground shadow-sm transition-all duration-300 hover:shadow-glow">
              <div class="p-6 text-center">
                <img
                  src={member.imageUrl}
                  alt={`Board member portrait of ${member.name}`}
                  width={160}
                  height={160}
                  loading="lazy"
                  decoding="async"
                  class="mx-auto mb-4 h-40 w-40 rounded-full object-cover shadow-primary"
                />
                <h3 class="mb-2 text-xl font-bold text-foreground">{member.name}</h3>
                <p class="mb-3 font-semibold text-secondary">{member.title}</p>
                <div class="board-bio mt-3 text-left text-sm text-muted-foreground" set:html={member.bio} />
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-accent py-16">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <div class="mb-12 text-center">
          <h2 class="mb-4 text-3xl font-bold text-foreground">{history.title}</h2>
          <p class="text-lg leading-relaxed text-muted-foreground">{history.content}</p>
        </div>

        <div class="flex flex-wrap justify-center gap-8 md:gap-12">
          {history.timeline.map((entry) => (
            <div class="text-center">
              <h3 class="mb-2 text-2xl font-bold text-secondary">{entry.year}</h3>
              <p class="font-medium text-foreground">{entry.title}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16">
      <div class="mx-auto max-w-[1800px] px-4 sm:px-8 lg:px-12">
        <div class="mx-auto mb-12 max-w-4xl text-center">
          <h2 class="mb-4 text-3xl font-bold text-foreground">{contact.title}</h2>
          <p class="text-lg text-muted-foreground">{contact.subtitle}</p>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
          <article class="rounded-lg border bg-card text-card-foreground shadow-sm">
            <div class="p-6 text-center">
              <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary/10">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={icons.mapPin} />
              </div>
              <h3 class="mb-4 text-xl font-bold text-foreground">{contact.visit.title}</h3>
              <div class="space-y-1 text-sm text-muted-foreground">
                {contact.visit.addressLines.map((line) => (
                  <p>{line}</p>
                ))}
                <p class="pt-4">{contact.visit.meetings}</p>
                <p>{contact.visit.location}</p>
              </div>
            </div>
          </article>

          <article class="rounded-lg border bg-card text-card-foreground shadow-sm">
            <div class="p-6 text-center">
              <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary/10">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={icons.mail} />
              </div>
              <h3 class="mb-4 text-xl font-bold text-foreground">{contact.emailCard.title}</h3>
              <div class="space-y-2 text-sm text-muted-foreground">
                <p>
                  <span class="font-medium text-foreground">{contact.emailCard.emailLabel}</span>
                  <br />
                  <a href={`mailto:${site.email}`} class="text-primary hover:underline">{site.email}</a>
                </p>
                <p>
                  <span class="font-medium text-foreground">{contact.emailCard.phoneLabel}</span>
                  <br />
                  <a href={`tel:${site.phone.replace(/\D/g, "")}`} class="text-primary hover:underline">{site.phone}</a>
                </p>
              </div>
              <button
                type="button"
                id="open-contact"
                class="mt-6 inline-flex h-10 items-center justify-center rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
              >
                {contact.emailCard.sendLabel}
              </button>
            </div>
          </article>

          <article class="rounded-lg border bg-card text-card-foreground shadow-sm">
            <div class="p-6 text-center">
              <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary/10">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={icons.heart} />
              </div>
              <h3 class="mb-4 text-xl font-bold text-foreground">{contact.social.title}</h3>
              <p class="mb-6 text-sm text-muted-foreground">{contact.social.description}</p>
              <div class="flex flex-wrap justify-center gap-3">
                {contact.social.links.map((link) => (
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex h-9 items-center justify-center rounded-md border border-border bg-background px-4 text-sm font-semibold text-foreground transition-colors hover:bg-muted"
                  >
                    {link.label}
                  </a>
                ))}
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>
  </div>

  <dialog
    id="contact-dialog"
    class="w-[calc(100%-2rem)] max-w-lg rounded-lg border border-border bg-card p-0 text-card-foreground shadow-lg backdrop:bg-black/50"
  >
    <form id="contact-form" class="p-6">
      <header class="mb-4">
        <h2 class="text-lg font-bold text-foreground">{contactDialog.title}</h2>
        <p class="mt-1 text-sm text-muted-foreground">{contactDialog.description}</p>
      </header>

      <div class="space-y-4">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label for="contact-name" class="mb-1 block text-sm font-medium text-foreground">{contactDialog.nameLabel} *</label>
            <input type="text" id="contact-name" name="name" required placeholder="Enter your name" class="flex h-10 w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40" />
          </div>
          <div>
            <label for="contact-email" class="mb-1 block text-sm font-medium text-foreground">{contactDialog.emailLabel} *</label>
            <input type="email" id="contact-email" name="email" required placeholder="Enter your email" class="flex h-10 w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40" />
          </div>
        </div>
        <div>
          <label for="contact-subject" class="mb-1 block text-sm font-medium text-foreground">{contactDialog.subjectLabel} *</label>
          <input type="text" id="contact-subject" name="subject" required placeholder="What is this about?" class="flex h-10 w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40" />
        </div>
        <div>
          <label for="contact-message" class="mb-1 block text-sm font-medium text-foreground">{contactDialog.messageLabel} *</label>
          <textarea id="contact-message" name="message" required rows={4} placeholder="Write your message here..." class="flex w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40"></textarea>
        </div>
      </div>

      <footer class="mt-6 flex justify-end gap-2">
        <button type="button" id="contact-cancel" class="inline-flex h-10 items-center justify-center rounded-md border border-border bg-background px-4 text-sm font-semibold text-foreground transition-colors hover:bg-muted">
          {contactDialog.cancel}
        </button>
        <button type="submit" class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90">
          <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={icons.send} />
          {contactDialog.send}
        </button>
      </footer>
    </form>
  </dialog>
</BaseLayout>

<style>
  .board-bio :global(p + p) {
    margin-top: 1em;
  }
</style>

<script define:vars={{ siteEmail: site.email }}>
  const contactDialogEl = document.getElementById("contact-dialog");
  const contactForm = document.getElementById("contact-form");
  const openContact = document.getElementById("open-contact");
  const contactCancel = document.getElementById("contact-cancel");

  openContact?.addEventListener("click", () => contactDialogEl?.showModal());
  contactCancel?.addEventListener("click", () => contactDialogEl?.close());
  contactDialogEl?.addEventListener("click", (event) => {
    if (event.target === contactDialogEl) contactDialogEl.close();
  });

  contactForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    const formData = new FormData(contactForm);
    const name = String(formData.get("name") ?? "");
    const email = String(formData.get("email") ?? "");
    const subject = String(formData.get("subject") ?? "");
    const message = String(formData.get("message") ?? "");
    const body = encodeURIComponent(`From: ${name} (${email})\n\n${message}`);
    window.location.href = `mailto:${siteEmail}?subject=${encodeURIComponent(subject)}&body=${body}`;
    contactDialogEl?.close();
  });
</script>
