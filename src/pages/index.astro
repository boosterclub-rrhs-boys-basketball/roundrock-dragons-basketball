---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
import { newsArticles, formatNewsDate } from "../data/news";
import { members } from "../data/members";
import { coaches } from "../data/coaches";
import { sponsors } from "../data/sponsors";
import { getUpcomingGames } from "../data/games";

const featuredCoach = coaches.find((c) => c.featured)!;
const featuredNews = newsArticles.slice(0, 3);
const upcomingGames = getUpcomingGames();
---

<BaseLayout>
  <section class="relative min-h-[85vh] flex items-center overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat"
      style="background-image: url('/hero-basketball.png');"
    ></div>
    <div class="absolute inset-0 bg-gradient-to-br from-dragon-maroon/90 via-dragon-maroon/80 to-dragon-dark/90"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 text-center text-white">
      <h1 class="font-display text-4xl sm:text-6xl lg:text-7xl font-bold uppercase tracking-wide leading-tight">
        Round Rock<br />
        <span class="text-dragon-gold">Dragons</span> Basketball
      </h1>
      <p class="mt-6 text-lg sm:text-xl max-w-2xl mx-auto text-white/90">{site.tagline}</p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a
          href="/donations"
          class="px-8 py-3 rounded-md bg-white text-dragon-maroon font-bold hover:bg-gray-100 transition-colors"
        >
          Support Our Team
        </a>
        <a
          href="/schedule"
          class="px-8 py-3 rounded-md border-2 border-white text-white font-bold hover:bg-white/10 transition-colors"
        >
          View Schedule
        </a>
      </div>

      <div class="mt-16 grid grid-cols-2 lg:grid-cols-4 gap-4 max-w-4xl mx-auto">
        {
          site.stats.map((stat) => (
            <div class="rounded-lg bg-black/30 backdrop-blur px-4 py-5 border border-white/10">
              <div class="text-3xl font-display font-bold">{stat.value}</div>
              <div class="text-sm text-white/80 mt-1">{stat.label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="font-display text-3xl sm:text-4xl font-bold text-dragon-maroon">Upcoming Games</h2>
        <p class="mt-2 text-gray-600">Support the Dragons at our next games!</p>
      </div>

      {
        upcomingGames.length === 0 ? (
          <p class="text-center text-gray-500 mb-8">No upcoming games scheduled at this time.</p>
        ) : (
          <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3 mb-8">
            {upcomingGames.map((game) => (
              <div class="rounded-xl border border-gray-200 p-6">
                <p class="text-sm text-dragon-maroon font-semibold">{game.team}</p>
                <h3 class="font-display text-xl font-bold mt-1">vs {game.opponent}</h3>
                <p class="text-gray-600 mt-2">{game.location}</p>
              </div>
            ))}
          </div>
        )
      }

      <div class="text-center">
        <a
          href="/schedule"
          class="inline-flex px-6 py-3 rounded-md bg-dragon-maroon text-white font-bold hover:bg-dragon-maroon-dark transition-colors"
        >
          View Full Schedule
        </a>
      </div>
    </div>
  </section>

  <section class="py-16 bg-dragon-maroon text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="font-display text-3xl sm:text-4xl font-bold">Latest News</h2>
        <p class="mt-2 text-white/80">Stay updated with Dragons basketball</p>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {
          featuredNews.map((article) => (
            <article class="rounded-xl bg-white/10 backdrop-blur border border-white/20 p-6 flex flex-col">
              <span class="text-xs uppercase tracking-wide text-dragon-gold font-semibold">{article.category}</span>
              <time class="text-sm text-white/70 mt-2">{formatNewsDate(article.date)}</time>
              <h3 class="font-display text-xl font-bold mt-3 flex-1">{article.title}</h3>
              <p class="text-white/80 mt-3 text-sm line-clamp-3">{article.excerpt}</p>
              <a href={`/news/${article.id}`} class="mt-4 text-dragon-gold font-semibold hover:underline">
                Read More
              </a>
            </article>
          ))
        }
      </div>

      <div class="text-center mt-10">
        <a href="/news" class="inline-flex px-6 py-3 rounded-md bg-white text-dragon-maroon font-bold hover:bg-gray-100">
          View All News
        </a>
      </div>
    </div>
  </section>

  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="font-display text-3xl sm:text-4xl font-bold text-dragon-maroon">Meet Our Dragons Family</h2>
        <p class="mt-2 text-gray-600">Hear from the incredible members who make our basketball program possible</p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {
          members.map((member) => (
            <blockquote class="rounded-xl bg-white border border-gray-200 p-8 shadow-sm">
              <span class="inline-block px-3 py-1 rounded-full bg-dragon-maroon/10 text-dragon-maroon text-xs font-bold uppercase">
                {member.tier}
              </span>
              <h3 class="font-display text-2xl font-bold mt-4">{member.name}</h3>
              <p class="mt-4 text-gray-600 leading-relaxed">{member.quote}</p>
            </blockquote>
          ))
        }
      </div>

      <div class="text-center mt-10">
        <a href="/members" class="inline-flex px-6 py-3 rounded-md bg-dragon-maroon text-white font-bold hover:bg-dragon-maroon-dark">
          View All Members
        </a>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="font-display text-3xl sm:text-4xl font-bold text-dragon-maroon">Meet Coach Levie</h2>
          <div class="mt-6 text-gray-600 space-y-4 leading-relaxed whitespace-pre-line">
            {featuredCoach.bio.split("\n\n").slice(0, 2).join("\n\n")}
          </div>
          {
            featuredCoach.careerHighlights && (
              <div class="mt-6">
                <p class="font-semibold text-gray-800">Over the past 17 years, he has served in multiple leadership roles:</p>
                <ul class="mt-3 space-y-2 text-gray-600 list-disc list-inside">
                  {featuredCoach.careerHighlights.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            )
          }
          <a href="/coaches" class="inline-flex mt-8 px-6 py-3 rounded-md bg-dragon-maroon text-white font-bold hover:bg-dragon-maroon-dark">
            Meet All Coaches
          </a>
        </div>

        <div class="rounded-2xl bg-dragon-dark text-white p-8">
          <h3 class="font-display text-2xl font-bold">{featuredCoach.name}</h3>
          <p class="text-dragon-gold font-semibold">{featuredCoach.title}</p>
          <p class="mt-4 text-white/80 text-sm">{featuredCoach.credentials}</p>
          <div class="grid grid-cols-3 gap-4 mt-8">
            {
              featuredCoach.stats.map((stat) => (
                <div class="text-center">
                  <div class="font-display text-2xl font-bold">{stat.value}</div>
                  <div class="text-xs text-white/70 mt-1">{stat.label}</div>
                </div>
              ))
            }
          </div>
          {
            featuredCoach.quote && (
              <blockquote class="mt-8 border-l-4 border-dragon-gold pl-4 italic text-white/90">
                "{featuredCoach.quote}"
              </blockquote>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="font-display text-3xl sm:text-4xl font-bold text-dragon-maroon">Proud Partners</h2>
        <p class="mt-2 text-gray-600">Supporting Excellence in Youth Basketball</p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          sponsors.map((sponsor) => (
            <div class="rounded-xl bg-white border border-gray-200 p-6 text-center shadow-sm">
              <span class="text-xs uppercase tracking-wide text-dragon-maroon font-bold">{sponsor.tier}</span>
              <h3 class="font-display text-lg font-bold mt-2">{sponsor.name}</h3>
              {
                sponsor.website && (
                  <a
                    href={sponsor.website}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-block mt-3 text-sm text-dragon-maroon hover:underline"
                  >
                    Visit Website
                  </a>
                )
              }
            </div>
          ))
        }
      </div>

      <div class="text-center mt-10 flex flex-wrap justify-center gap-4">
        <a href="/sponsors" class="inline-flex px-6 py-3 rounded-md bg-dragon-maroon text-white font-bold hover:bg-dragon-maroon-dark">
          View Sponsorship Packages
        </a>
        <a href={`mailto:${site.email}`} class="inline-flex px-6 py-3 rounded-md border-2 border-dragon-maroon text-dragon-maroon font-bold hover:bg-dragon-maroon/5">
          Contact Us Today
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
