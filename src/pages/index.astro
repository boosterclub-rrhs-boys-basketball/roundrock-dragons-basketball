---
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsCard from "../components/NewsCard.astro";
import SectionContainer from "../components/SectionContainer.astro";
import SectionHeading from "../components/SectionHeading.astro";
import PrimaryButton from "../components/PrimaryButton.astro";
import MemberCarousel from "../components/MemberCarousel.astro";
import CoachLevieSection from "../components/CoachLevieSection.astro";
import ProudPartnersSection from "../components/ProudPartnersSection.astro";
import { site } from "../data/site";
import { newsArticles } from "../data/news";
import { members } from "../data/members";
import { coaches } from "../data/coaches";
import { getUpcomingGames, formatGameDate } from "../data/games";

const featuredCoach = coaches.find((c) => c.featured)!;
const featuredNews = newsArticles.slice(0, 3);
const upcomingGames = getUpcomingGames();
---

<BaseLayout>
  <section class="relative min-h-[600px] lg:min-h-[650px] flex items-center justify-center overflow-hidden py-12">
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat"
      style="background-image: url('/hero-basketball.png');"
    >
      <div class="absolute inset-0 bg-gradient-to-r from-dragon-maroon/90 via-dragon-maroon/70 to-transparent"></div>
    </div>

    <div class="relative z-10 w-full max-w-[1800px] mx-auto px-4 sm:px-8 lg:px-12 text-center lg:text-left">
      <div class="grid lg:grid-cols-2 gap-8 items-center">
        <div>
          <h1 class="font-display text-3xl md:text-5xl font-black uppercase tracking-wider leading-tight text-white mb-5 text-shadow fade-in-up">
            Round Rock
            <span class="block text-dragon-silver">Dragons</span>
            <span class="block text-2xl md:text-3xl">Basketball</span>
          </h1>
          <p class="text-lg md:text-xl text-white/90 mb-6 text-shadow max-w-xl mx-auto lg:mx-0 fade-in-up">
            {site.tagline}
          </p>
          <div class="flex flex-col sm:flex-row gap-4 mb-8 justify-center lg:justify-start fade-in-up">
            <a
              href="/donations"
              class="inline-flex items-center justify-center h-11 px-8 text-lg font-semibold rounded-md bg-dragon-silver text-dragon-silver-fg hover:bg-dragon-silver/80 transition-all duration-300 shadow-glow"
            >
              Support Our Team
            </a>
            <a
              href="/schedule"
              class="inline-flex items-center justify-center h-11 px-8 text-lg font-semibold rounded-md border-2 border-white/80 text-white bg-white/10 backdrop-blur-sm hover:bg-white hover:text-dragon-maroon transition-all duration-300"
            >
              View Schedule
            </a>
          </div>

          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 max-w-xl mx-auto lg:mx-0 fade-in-up">
            {
              site.stats.map((stat) => (
                <div class="bg-white/10 backdrop-blur-sm rounded-lg p-3 text-center">
                  <img
                    src="/dragons-logo.png"
                    alt=""
                    class="h-7 w-7 mx-auto mb-2 object-contain brightness-0 invert"
                    aria-hidden="true"
                  />
                  <div class="text-xl font-bold text-white">{stat.value}</div>
                  <div class="text-xs text-white/80 mt-1">{stat.label}</div>
                </div>
              ))
            }
          </div>
        </div>
        <div class="hidden lg:block" aria-hidden="true"></div>
      </div>
    </div>

    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 animate-bounce pointer-events-none" aria-hidden="true">
      <div class="w-5 h-8 border-2 border-white rounded-full flex justify-center">
        <div class="w-1 h-2 bg-white rounded-full mt-2"></div>
      </div>
    </div>
  </section>

  <section class="py-8 bg-background font-sans">
    <SectionContainer>
      <SectionHeading
        title="Upcoming Games"
        subtitle="Support the Dragons at our next games!"
        size="sm"
      />

      {
        upcomingGames.length === 0 ? (
          <p class="text-center text-muted-foreground mb-8">No upcoming games scheduled at this time.</p>
        ) : (
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 mb-8">
            {upcomingGames.map((game) => (
              <div class="group rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition-all duration-300 hover:scale-105 hover:shadow-dramatic">
                <div class="flex items-center justify-between gap-2">
                  <span class="text-xs uppercase tracking-wide font-bold text-dragon-maroon">{game.team}</span>
                  <span
                    class:list={[
                      "text-xs font-semibold px-2 py-0.5 rounded",
                      game.home ? "bg-dragon-maroon/10 text-dragon-maroon" : "bg-gray-100 text-gray-600",
                    ]}
                  >
                    {game.home ? "Home" : "Away"}
                  </span>
                </div>
                <h3 class="text-base font-semibold leading-none tracking-tight text-card-foreground">vs {game.opponent}</h3>
                <p class="text-sm text-muted-foreground mt-3">{formatGameDate(game)}</p>
                <p class="text-sm text-muted-foreground mt-1">{game.location}</p>
              </div>
            ))}
          </div>
        )
      }

      <div class="text-center">
        <PrimaryButton href="/schedule">View Full Schedule</PrimaryButton>
      </div>
    </SectionContainer>
  </section>

  <section class="py-8 bg-accent font-sans">
    <SectionContainer>
      <SectionHeading
        title="Latest News"
        subtitle="Stay updated with Dragons basketball"
        light
        size="lg"
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
        {featuredNews.map((article) => <NewsCard article={article} darkSection />)}
      </div>

      <div class="text-center">
        <PrimaryButton href="/news">View All News</PrimaryButton>
      </div>
    </SectionContainer>
  </section>

  <MemberCarousel members={members} />

  <CoachLevieSection coach={featuredCoach} />

  <ProudPartnersSection />
</BaseLayout>
