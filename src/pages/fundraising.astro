---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionContainer from "../components/SectionContainer.astro";
import {
  fundraisingPage,
  progressPercent,
  formatCurrency,
  statusColors,
  type FundraisingEvent,
} from "../data/fundraisingPage";
import { site } from "../data/site";

const {
  hero,
  tabs,
  eventsSection,
  volunteerSection,
  events,
  recentDonors,
  volunteerOpportunities,
  contactDialog,
} = fundraisingPage;

const featuredEvent = events.find((e) => e.featured);
const otherEvents = events.filter((e) => !e.featured);

const badgeBase =
  "inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold transition-colors";

const icons = {
  calendar: `<path d="M8 2v4" /><path d="M16 2v4" /><rect width="18" height="18" x="3" y="4" rx="2" /><path d="M3 10h18" />`,
  clock: `<circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" />`,
  mapPin: `<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" /><circle cx="12" cy="10" r="3" />`,
  users: `<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />`,
  target: `<circle cx="12" cy="12" r="10" /><circle cx="12" cy="12" r="6" /><circle cx="12" cy="12" r="2" />`,
  mail: `<rect width="20" height="16" x="2" y="4" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />`,
  external: `<path d="M15 3h6v6" /><path d="M10 14 21 3" /><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />`,
  send: `<path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z" /><path d="m21.854 2.147-10.94 10.939" />`,
};

function eventMailto(event: FundraisingEvent, subject?: string) {
  return `mailto:${site.email}?subject=${encodeURIComponent(subject ?? `Fundraising: ${event.name}`)}`;
}
---

<BaseLayout title="Fundraising & Volunteers" description="Fundraising events and volunteer opportunities for Round Rock Dragons basketball.">
  <div class="min-h-screen bg-background font-system">
    <section class="hero-gradient py-20">
      <div class="mx-auto max-w-[1800px] px-4 text-center sm:px-8 lg:px-12">
        <h1 class="mb-4 text-4xl font-bold text-primary-foreground text-shadow md:text-6xl">{hero.title}</h1>
        <p class="mx-auto max-w-4xl text-xl font-normal text-primary-foreground/90 text-shadow xl:max-w-5xl">{hero.subtitle}</p>
      </div>
    </section>

    <SectionContainer class="py-16">
      <div class="w-full" id="fundraising-tabs">
        <div
          role="tablist"
          aria-label="Fundraising sections"
          class="grid h-10 w-full grid-cols-2 items-center justify-center rounded-md bg-muted p-1 text-muted-foreground"
        >
          <button
            type="button"
            role="tab"
            id="tab-events"
            aria-controls="panel-events"
            aria-selected="true"
            data-tab-trigger="events"
            data-state="active"
            class="inline-flex items-center justify-center whitespace-nowrap rounded-sm px-3 py-1.5 text-sm font-medium transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 data-[state=active]:bg-background data-[state=active]:text-foreground data-[state=active]:shadow-sm"
          >
            {tabs.events}
          </button>
          <button
            type="button"
            role="tab"
            id="tab-volunteer"
            aria-controls="panel-volunteer"
            aria-selected="false"
            data-tab-trigger="volunteer"
            data-state="inactive"
            class="inline-flex items-center justify-center whitespace-nowrap rounded-sm px-3 py-1.5 text-sm font-medium transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 data-[state=active]:bg-background data-[state=active]:text-foreground data-[state=active]:shadow-sm"
          >
            {tabs.volunteer}
          </button>
        </div>

        <div id="panel-events" role="tabpanel" aria-labelledby="tab-events" data-tab-panel="events" class="mt-8">
          <div class="mb-8">
            <h2 class="mb-4 text-3xl font-bold text-foreground">{eventsSection.title}</h2>
            <p class="text-base font-normal text-muted-foreground">{eventsSection.description}</p>
          </div>

          {
            events.length === 0 ? (
              <article class="rounded-lg border bg-card py-12 text-center text-card-foreground shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto mb-4 h-12 w-12 opacity-50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={icons.target} />
                <p class="text-muted-foreground">{eventsSection.empty}</p>
              </article>
            ) : (
              <>
                {
                  featuredEvent && (
                    <div class="mb-12 grid grid-cols-1 gap-8 lg:grid-cols-3">
                      <article class="overflow-hidden rounded-lg border bg-card text-card-foreground shadow-dramatic lg:col-span-2">
                        <div class:list={["grid grid-cols-1", featuredEvent.image && "lg:grid-cols-2"]}>
                          {
                            featuredEvent.image && (
                              <div class="h-64 lg:h-auto">
                                <img src={featuredEvent.image} alt="" class="h-full w-full object-cover" loading="lazy" />
                              </div>
                            )
                          }
                          <div class="p-8">
                            <div class="mb-4 flex items-center">
                              <span class={`${badgeBase} mr-3 border-transparent bg-secondary text-secondary-foreground`}>
                                {eventsSection.featuredBadge}
                              </span>
                              <span class={`${badgeBase} border-transparent text-white ${statusColors[featuredEvent.status]}`}>
                                {featuredEvent.status}
                              </span>
                            </div>
                            <h3 class="mb-4 text-2xl font-bold text-foreground">{featuredEvent.name}</h3>
                            <p class="mb-6 text-base font-normal text-muted-foreground">{featuredEvent.description}</p>

                            <div class="mb-6 space-y-4">
                              <div class="flex items-center text-sm font-normal text-foreground">
                                <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-4 w-4 shrink-0 text-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={icons.calendar} />
                                {featuredEvent.eventDate}
                                {featuredEvent.eventTime && ` at ${featuredEvent.eventTime} CST`}
                              </div>
                              <div class="flex items-center text-sm font-normal text-foreground">
                                <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-4 w-4 shrink-0 text-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={icons.mapPin} />
                                {featuredEvent.location}
                              </div>
                            </div>

                            {
                              (() => {
                                const pct = progressPercent(featuredEvent.raised, featuredEvent.goal);
                                return (
                                  <div class="mb-6">
                                    <div class="mb-2 flex justify-between text-sm font-normal">
                                      <span>{eventsSection.raisedLabel}: ${formatCurrency(featuredEvent.raised)}</span>
                                      <span>{eventsSection.goalLabel}: ${formatCurrency(featuredEvent.goal)}</span>
                                    </div>
                                    <div class="h-3 w-full overflow-hidden rounded-full bg-muted">
                                      <div class="h-full rounded-full bg-secondary transition-all duration-300" style={`width: ${pct}%`}></div>
                                    </div>
                                    <p class="mt-1 text-center text-sm text-muted-foreground">{eventsSection.percentReached(pct)}</p>
                                  </div>
                                );
                              })()
                            }

                            <div class="flex flex-wrap gap-4">
                              {
                                featuredEvent.externalLink && (
                                  <a
                                    href={featuredEvent.externalLink}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="inline-flex h-10 items-center justify-center rounded-md bg-gradient-primary px-4 text-sm font-semibold text-primary-foreground transition-colors hover:opacity-90"
                                  >
                                    <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={icons.external} />
                                    {eventsSection.learnMore}
                                  </a>
                                )
                              }
                              <button
                                type="button"
                                class="contact-trigger inline-flex h-10 items-center justify-center rounded-md border-2 border-primary bg-card px-4 text-sm font-semibold text-primary transition-all duration-300 hover:bg-primary hover:text-primary-foreground"
                                data-event-id={featuredEvent.id}
                                data-event-name={featuredEvent.name}
                                data-contact-type="event"
                              >
                                <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={icons.mail} />
                                {eventsSection.contactCoordinator}
                              </button>
                            </div>
                          </div>
                        </div>
                      </article>

                      <aside class="space-y-6">
                        <article class="rounded-lg border bg-card text-card-foreground shadow-sm">
                          <header class="flex flex-col space-y-1.5 p-6">
                            <h3 class="text-lg font-semibold leading-none tracking-tight text-foreground">{eventsSection.supportersTitle}</h3>
                          </header>
                          <div class="p-6 pt-0">
                            {
                              recentDonors.length > 0 ? (
                                <div class="space-y-3">
                                  {
                                    recentDonors.map((donor) => (
                                      <div class="flex items-center justify-between rounded-lg bg-muted p-3">
                                        <div>
                                          <p class="font-medium text-foreground">{donor.displayName}</p>
                                          <p class="text-xs text-muted-foreground">{donor.date}</p>
                                        </div>
                                        <span class={`${badgeBase} border-transparent bg-secondary text-secondary-foreground`}>
                                          ${formatCurrency(donor.amount)}
                                        </span>
                                      </div>
                                    ))
                                  }
                                </div>
                              ) : (
                                <p class="text-sm text-muted-foreground">{eventsSection.supportersEmpty}</p>
                              )
                            }
                          </div>
                        </article>
                      </aside>
                    </div>
                  )
                }

                {
                  otherEvents.length > 0 && (
                    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
                      {
                        otherEvents.map((event) => {
                          const pct = progressPercent(event.raised, event.goal);
                          return (
                            <article class="overflow-hidden rounded-lg border bg-card text-card-foreground shadow-sm transition-all duration-300 hover:shadow-glow">
                              {
                                event.image && (
                                  <div class="relative h-48 overflow-hidden">
                                    <img src={event.image} alt="" class="h-full w-full object-cover" loading="lazy" />
                                  </div>
                                )
                              }
                              <header class="flex flex-col space-y-1.5 p-6">
                                <div class="flex items-center justify-between gap-2">
                                  <h3 class="text-2xl font-semibold leading-none tracking-tight text-foreground">{event.name}</h3>
                                  <span class={`${badgeBase} shrink-0 text-foreground`}>{event.status}</span>
                                </div>
                              </header>
                              <div class="p-6 pt-0">
                                <p class="mb-4 text-base font-normal text-muted-foreground">{event.description}</p>

                                <div class="mb-4 space-y-2 text-sm font-normal text-foreground">
                                  <div class="flex items-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-4 w-4 shrink-0 text-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={icons.calendar} />
                                    {event.eventDateLong}
                                  </div>
                                  {
                                    event.eventTime && (
                                      <div class="flex items-center">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-4 w-4 shrink-0 text-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={icons.clock} />
                                        {event.eventTime}
                                      </div>
                                    )
                                  }
                                  <div class="flex items-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-4 w-4 shrink-0 text-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={icons.mapPin} />
                                    {event.location}
                                  </div>
                                </div>

                                <div class="mb-4">
                                  <div class="mb-2 flex justify-between text-sm font-normal">
                                    <span>{eventsSection.progressLabel}</span>
                                    <span>${formatCurrency(event.raised)} of ${formatCurrency(event.goal)}</span>
                                  </div>
                                  <div class="h-2 w-full overflow-hidden rounded-full bg-muted">
                                    <div class="h-full rounded-full bg-secondary transition-all duration-300" style={`width: ${pct}%`}></div>
                                  </div>
                                </div>

                                <div class="flex gap-2">
                                  <button
                                    type="button"
                                    class="contact-trigger inline-flex h-9 flex-1 items-center justify-center rounded-md border-2 border-primary bg-card px-3 text-sm font-semibold text-primary transition-all duration-300 hover:bg-primary hover:text-primary-foreground"
                                    data-event-id={event.id}
                                    data-event-name={event.name}
                                    data-contact-type="event"
                                  >
                                    <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={icons.mail} />
                                    {eventsSection.contact}
                                  </button>
                                  {
                                    event.externalLink ? (
                                      <a
                                        href={event.externalLink}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="inline-flex h-9 flex-1 items-center justify-center rounded-md bg-gradient-primary px-3 text-sm font-semibold text-primary-foreground transition-colors hover:opacity-90"
                                      >
                                        <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={icons.external} />
                                        {eventsSection.donate}
                                      </a>
                                    ) : (
                                      <a
                                        href={eventMailto(event, `Donation - ${event.name}`)}
                                        class="inline-flex h-9 flex-1 items-center justify-center rounded-md bg-gradient-primary px-3 text-sm font-semibold text-primary-foreground transition-colors hover:opacity-90"
                                      >
                                        <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={icons.external} />
                                        {eventsSection.donate}
                                      </a>
                                    )
                                  }
                                </div>
                              </div>
                            </article>
                          );
                        })
                      }
                    </div>
                  )
                }
              </>
            )
          }
        </div>

        <div id="panel-volunteer" role="tabpanel" aria-labelledby="tab-volunteer" data-tab-panel="volunteer" hidden class="mt-8">
          <div class="mb-8">
            <h2 class="mb-4 text-3xl font-bold text-foreground">{volunteerSection.title}</h2>
            <p class="text-muted-foreground">{volunteerSection.description}</p>
          </div>

          {
            volunteerOpportunities.length > 0 ? (
              <div class="mb-12 grid grid-cols-1 gap-8 md:grid-cols-2">
                {
                  volunteerOpportunities.map((opportunity) => (
                    <article class="rounded-lg border bg-card text-card-foreground shadow-sm transition-all duration-300 hover:shadow-glow">
                      <header class="flex flex-col space-y-1.5 p-6">
                        <h3 class="flex items-center text-2xl font-semibold leading-none tracking-tight text-foreground">
                          <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-5 w-5 shrink-0 text-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={icons.users} />
                          {opportunity.title}
                        </h3>
                      </header>
                      <div class="p-6 pt-0">
                        <p
                          class:list={[
                            "mb-4 text-muted-foreground",
                            opportunity.description.includes("\n") && "whitespace-pre-line",
                          ]}
                        >
                          {opportunity.description.trim()}
                        </p>
                        <div class="mb-6 space-y-2 text-sm text-foreground">
                          <div class="flex items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-4 w-4 shrink-0 text-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={icons.clock} />
                            <span><strong>{volunteerSection.timeCommitment}:</strong> {opportunity.commitment}</span>
                          </div>
                          <div class="flex items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-4 w-4 shrink-0 text-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={icons.calendar} />
                            <span><strong>{volunteerSection.when}:</strong> {opportunity.whenNeeded}</span>
                          </div>
                        </div>
                        <div class="flex gap-2">
                          <button
                            type="button"
                            class="contact-trigger inline-flex h-9 flex-1 items-center justify-center whitespace-nowrap rounded-md border border-primary bg-background px-3 text-sm font-semibold text-primary transition-all duration-300 hover:bg-primary hover:text-primary-foreground"
                            data-event-id={opportunity.id}
                            data-event-name={opportunity.title}
                            data-contact-type="volunteer"
                          >
                            <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={icons.mail} />
                            {volunteerSection.contactCoordinator}
                          </button>
                          {
                            opportunity.signupUrl && (
                              <a
                                href={opportunity.signupUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex h-9 flex-1 items-center justify-center whitespace-nowrap rounded-md bg-primary px-3 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
                              >
                                <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={icons.external} />
                                {volunteerSection.signUp}
                              </a>
                            )
                          }
                        </div>
                      </div>
                    </article>
                  ))
                }
              </div>
            ) : (
              <article class="mb-12 rounded-lg border bg-card py-12 text-center text-card-foreground shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto mb-4 h-12 w-12 opacity-50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={icons.users} />
                <p class="text-muted-foreground">{volunteerSection.empty}</p>
              </article>
            )
          }

          <article class="mx-auto max-w-2xl rounded-lg border bg-card text-card-foreground shadow-sm">
            <header class="flex flex-col space-y-1.5 p-6 text-center">
              <h3 class="text-2xl font-semibold leading-none tracking-tight text-foreground">{volunteerSection.form.title}</h3>
              <p class="text-sm font-normal text-muted-foreground">{volunteerSection.form.subtitle}</p>
            </header>
            <div class="p-6 pt-0">
              <div id="volunteer-success" class="hidden rounded-md border border-green-500/30 bg-green-500/10 px-4 py-3 text-sm text-green-800" role="status">
                <p class="font-semibold">{volunteerSection.form.successTitle}</p>
                <p class="mt-1">{volunteerSection.form.successDescription}</p>
              </div>

              <form id="volunteer-form" class="space-y-6">
                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                  <div>
                    <label for="vol-name" class="mb-1 block text-sm font-medium text-foreground">{volunteerSection.form.nameLabel}</label>
                    <input
                      type="text"
                      id="vol-name"
                      name="name"
                      required
                      class="flex h-10 w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40"
                    />
                  </div>
                  <div>
                    <label for="vol-email" class="mb-1 block text-sm font-medium text-foreground">{volunteerSection.form.emailLabel}</label>
                    <input
                      type="email"
                      id="vol-email"
                      name="email"
                      required
                      class="flex h-10 w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40"
                    />
                  </div>
                </div>

                <div>
                  <label for="vol-phone" class="mb-1 block text-sm font-medium text-foreground">{volunteerSection.form.phoneLabel}</label>
                  <input
                    type="tel"
                    id="vol-phone"
                    name="phone"
                    class="flex h-10 w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40"
                  />
                </div>

                {
                  volunteerOpportunities.length > 0 && (
                    <fieldset>
                      <legend class="mb-2 block text-sm font-medium text-foreground">{volunteerSection.form.interestsLabel}</legend>
                      <div class="mt-2 grid grid-cols-1 gap-2 sm:grid-cols-2">
                        {
                          volunteerOpportunities.map((opportunity) => (
                            <label class="flex items-center gap-2 text-sm text-foreground">
                              <input type="checkbox" name="interests" value={opportunity.title} class="h-4 w-4 rounded border-border text-primary focus:ring-primary/40" />
                              <span>{opportunity.title}</span>
                            </label>
                          ))
                        }
                      </div>
                    </fieldset>
                  )
                }

                <div>
                  <label for="vol-availability" class="mb-1 block text-sm font-medium text-foreground">{volunteerSection.form.availabilityLabel}</label>
                  <input
                    type="text"
                    id="vol-availability"
                    name="availability"
                    placeholder={volunteerSection.form.availabilityPlaceholder}
                    class="flex h-10 w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40"
                  />
                </div>

                <div>
                  <label for="vol-message" class="mb-1 block text-sm font-medium text-foreground">{volunteerSection.form.messageLabel}</label>
                  <textarea
                    id="vol-message"
                    name="message"
                    rows={3}
                    placeholder={volunteerSection.form.messagePlaceholder}
                    class="flex w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40"
                  ></textarea>
                </div>

                <button
                  type="submit"
                  class="inline-flex h-11 w-full items-center justify-center rounded-md bg-gradient-primary px-8 text-sm font-semibold text-primary-foreground transition-colors hover:opacity-90"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={icons.users} />
                  {volunteerSection.form.submitLabel}
                </button>
              </form>
            </div>
          </article>
        </div>
      </div>
    </SectionContainer>
  </div>

  <dialog id="contact-dialog" class="w-[calc(100%-2rem)] max-w-lg rounded-lg border border-border bg-card p-0 text-card-foreground shadow-lg backdrop:bg-black/50">
    <form id="contact-form" class="p-6">
      <header class="mb-4">
        <h2 id="contact-dialog-title" class="text-lg font-bold text-foreground">{contactDialog.title}</h2>
        <p id="contact-dialog-description" class="mt-1 text-sm text-muted-foreground"></p>
      </header>

      <div class="space-y-4">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label for="contact-name" class="mb-1 block text-sm font-medium text-foreground">{contactDialog.nameLabel}</label>
            <input type="text" id="contact-name" name="name" required placeholder="Enter your name" class="flex h-10 w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40" />
          </div>
          <div>
            <label for="contact-email" class="mb-1 block text-sm font-medium text-foreground">{contactDialog.emailLabel}</label>
            <input type="email" id="contact-email" name="email" required placeholder="Enter your email" class="flex h-10 w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40" />
          </div>
        </div>
        <div>
          <label for="contact-subject" class="mb-1 block text-sm font-medium text-foreground">{contactDialog.subjectLabel}</label>
          <input type="text" id="contact-subject" name="subject" required placeholder="What is this about?" class="flex h-10 w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40" />
        </div>
        <div>
          <label for="contact-message" class="mb-1 block text-sm font-medium text-foreground">{contactDialog.messageLabel}</label>
          <textarea id="contact-message" name="message" required rows={4} placeholder="Write your message here..." class="flex w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40"></textarea>
        </div>
      </div>

      <footer class="mt-6 flex justify-end gap-2">
        <button type="button" id="contact-cancel" class="inline-flex h-10 items-center justify-center rounded-md border border-border bg-background px-4 text-sm font-semibold text-foreground transition-colors hover:bg-muted">
          {contactDialog.cancel}
        </button>
        <button type="submit" class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90">
          <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={icons.send} />
          {contactDialog.send}
        </button>
      </footer>
    </form>
  </dialog>
</BaseLayout>

<script define:vars={{ siteEmail: site.email, contactDialogTitle: contactDialog.title, contactDialogVolunteerTitle: contactDialog.volunteerTitle }}>
  const triggers = document.querySelectorAll("[data-tab-trigger]");
  const panels = document.querySelectorAll("[data-tab-panel]");
  const contactDialogEl = document.getElementById("contact-dialog");
  const contactForm = document.getElementById("contact-form");
  const contactTitle = document.getElementById("contact-dialog-title");
  const contactDescription = document.getElementById("contact-dialog-description");
  const contactCancel = document.getElementById("contact-cancel");
  const volunteerForm = document.getElementById("volunteer-form");
  const volunteerSuccess = document.getElementById("volunteer-success");

  let activeContactContext = { name: "", type: "event" };

  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const tab = trigger.dataset.tabTrigger;
      triggers.forEach((t) => {
        const active = t.dataset.tabTrigger === tab;
        t.setAttribute("aria-selected", active ? "true" : "false");
        t.dataset.state = active ? "active" : "inactive";
      });
      panels.forEach((panel) => {
        const active = panel.dataset.tabPanel === tab;
        panel.toggleAttribute("hidden", !active);
      });
    });
  });

  document.querySelectorAll(".contact-trigger").forEach((button) => {
    button.addEventListener("click", () => {
      const eventName = button.dataset.eventName ?? "Fundraising Event";
      const contactType = button.dataset.contactType ?? "event";
      activeContactContext = { name: eventName, type: contactType };

      if (contactTitle) {
        contactTitle.textContent =
          contactType === "volunteer" ? contactDialogVolunteerTitle : contactDialogTitle;
      }
      if (contactDescription) {
        contactDescription.textContent =
          contactType === "volunteer"
            ? `Send a message about "${eventName}" — your message will be forwarded to the volunteer coordinator.`
            : `Send a message about "${eventName}" — your message will be forwarded to the event coordinator.`;
      }
      const subjectInput = document.getElementById("contact-subject");
      if (subjectInput) subjectInput.value = eventName;

      contactDialogEl?.showModal();
    });
  });

  contactCancel?.addEventListener("click", () => contactDialogEl?.close());
  contactDialogEl?.addEventListener("click", (event) => {
    if (event.target === contactDialogEl) contactDialogEl.close();
  });

  contactForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    const form = event.currentTarget;
    const data = new FormData(form);
    const body = [
      `Name: ${data.get("name")}`,
      `Email: ${data.get("email")}`,
      "",
      String(data.get("message")),
    ].join("\n");
    const subject = String(data.get("subject") ?? activeContactContext.name);
    window.location.href = `mailto:${siteEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    contactDialogEl?.close();
    form.reset();
  });

  volunteerForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    const form = event.currentTarget;
    const data = new FormData(form);
    const interests = data.getAll("interests").join(", ");
    const body = [
      `Name: ${data.get("name")}`,
      `Email: ${data.get("email")}`,
      `Phone: ${data.get("phone") || "Not provided"}`,
      `Interests: ${interests || "None selected"}`,
      `Availability: ${data.get("availability") || "Not provided"}`,
      "",
      String(data.get("message") || ""),
    ].join("\n");

    window.location.href = `mailto:${siteEmail}?subject=${encodeURIComponent("Volunteer Application")}&body=${encodeURIComponent(body)}`;

    form.classList.add("hidden");
    volunteerSuccess?.classList.remove("hidden");
    setTimeout(() => {
      form.reset();
      form.classList.remove("hidden");
      volunteerSuccess?.classList.add("hidden");
    }, 4000);
  });
</script>
