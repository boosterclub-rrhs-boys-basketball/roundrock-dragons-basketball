---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getSortedSponsors,
  getTierBadgeGradient,
  formatTierBadgeLabel,
  sponsorshipPackages,
} from "../data/sponsors";
import { sponsorsPage } from "../data/sponsorsPage";
import { site } from "../data/site";

const { hero, whySponsor, packages, partners, cta, contactDialog } = sponsorsPage;
const sortedSponsors = getSortedSponsors();

const badgeBase =
  "inline-flex items-center rounded-full border border-transparent px-2.5 text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2";
const secondaryBtnLg =
  "inline-flex h-11 items-center justify-center rounded-md bg-secondary px-8 text-lg font-semibold text-secondary-foreground shadow-glow transition-all duration-300 hover:bg-secondary/80";
const secondaryBtn =
  "inline-flex h-11 items-center justify-center rounded-md bg-secondary px-8 text-sm font-semibold text-secondary-foreground shadow-glow transition-all duration-300 hover:bg-secondary/80";
const outlineBtn =
  "inline-flex h-10 items-center justify-center rounded-md border-2 border-primary bg-card px-4 py-2 text-sm font-semibold text-primary transition-all duration-300 hover:bg-primary hover:text-primary-foreground";
const outlineSmBtn =
  "inline-flex h-9 items-center justify-center rounded-md border-2 border-primary bg-card px-3 text-sm font-semibold text-primary transition-all duration-300 hover:bg-primary hover:text-primary-foreground";

const icons = {
  users: `<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />`,
  trending: `<path d="M22 7 13.5 15.5 8.5 10.5 2 17" /><path d="M16 7h6v6" />`,
  megaphone: `<path d="m3 11 18-5v12L3 14v-3z" /><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6" />`,
  star: `<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />`,
  check: `<path d="M20 6 9 17l-5-5" />`,
  download: `<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" x2="12" y1="15" y2="3" />`,
  external: `<path d="M15 3h6v6" /><path d="M10 14 21 3" /><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />`,
  send: `<path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z" /><path d="m21.854 2.147-10.94 10.939" />`,
};

function whyIcon(icon: (typeof whySponsor.items)[number]["icon"]) {
  return icons[icon];
}
---

<BaseLayout title="Sponsors" description="Partner with Round Rock Dragons basketball.">
  <div class="min-h-screen bg-background font-system">
    <section class="hero-gradient py-20">
      <div class="mx-auto max-w-[1800px] px-4 text-center sm:px-8 lg:px-12">
        <h1 class="mb-4 text-4xl font-bold text-primary-foreground text-shadow md:text-6xl">{hero.title}</h1>
        <p class="mx-auto mb-8 max-w-3xl text-xl text-primary-foreground/90 text-shadow">{hero.subtitle}</p>
        <div class="flex flex-col justify-center gap-4 sm:flex-row">
          <a
            href={`mailto:${site.email}?subject=${encodeURIComponent("Sponsorship Application")}`}
            class={secondaryBtnLg}
          >
            {hero.becomeLabel}
          </a>
          <a href={hero.packetHref} target="_blank" rel="noopener noreferrer" class={secondaryBtnLg}>
            <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={icons.download} />
            {hero.downloadLabel}
          </a>
        </div>
      </div>
    </section>

    <section class="bg-muted py-16">
      <div class="mx-auto max-w-[1800px] px-4 sm:px-8 lg:px-12">
        <div class="mb-12 text-center">
          <h2 class="mb-4 text-3xl font-bold text-foreground md:text-4xl">{whySponsor.title}</h2>
          <p class="text-xl text-muted-foreground">{whySponsor.subtitle}</p>
        </div>

        <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
          {
            whySponsor.items.map((item) => (
              <div class="text-center">
                <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-primary">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={whyIcon(item.icon)} />
                </div>
                <h3 class="mb-2 text-xl font-semibold text-foreground">{item.title}</h3>
                <p class="text-muted-foreground">{item.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="py-16">
      <div class="mx-auto max-w-[1800px] px-4 sm:px-8 lg:px-12">
        <div class="mb-12 text-center">
          <h2 class="mb-4 text-3xl font-bold text-foreground md:text-4xl">{packages.title}</h2>
          <p class="text-xl text-muted-foreground">{packages.subtitle}</p>
        </div>

        <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
          {
            sponsorshipPackages.map((pkg) => (
              <article class="relative rounded-lg border bg-card text-card-foreground shadow-sm transition-all duration-300 hover:scale-105 hover:shadow-dramatic">
                <header class="flex flex-col space-y-1.5 p-6 text-center">
                  <h3 class="text-2xl font-bold leading-none tracking-tight text-foreground">
                    {"subtitle" in pkg && pkg.subtitle ? (
                      <span class="flex flex-col items-center">
                        <span>{pkg.name}</span>
                        <span class="mt-1 text-sm font-normal text-muted-foreground">{pkg.subtitle}</span>
                      </span>
                    ) : (
                      pkg.name
                    )}
                  </h3>
                  <div class="text-3xl font-bold text-primary">{pkg.price}</div>
                </header>
                <div class="p-6 pt-0">
                  <ul class="space-y-3">
                    {
                      pkg.highlights.map((item) => (
                        <li class="flex items-start space-x-2">
                          <svg xmlns="http://www.w3.org/2000/svg" class="mt-1 h-4 w-4 shrink-0 text-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={icons.check} />
                          <span class="text-sm text-foreground">{item}</span>
                        </li>
                      ))
                    }
                  </ul>
                  <a
                    href={`mailto:${site.email}?subject=${encodeURIComponent(pkg.name + " Sponsorship")}`}
                    class:list={["mt-6 w-full", outlineBtn]}
                  >
                    {packages.chooseLabel}
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    {
      sortedSponsors.length > 0 && (
        <section class="bg-accent py-16">
          <div class="mx-auto max-w-[1800px] px-4 sm:px-8 lg:px-12">
            <div class="mb-12 text-center">
              <h2 class="mb-4 text-3xl font-bold text-foreground md:text-4xl">{partners.title}</h2>
              <p class="text-xl text-muted-foreground">{partners.subtitle}</p>
            </div>

            <div class="grid grid-cols-1 gap-8 md:grid-cols-3 lg:grid-cols-4">
              {
                sortedSponsors.map((sponsor) => {
                  const tierLabel = formatTierBadgeLabel(sponsor.tier);
                  return (
                    <article class="rounded-lg border bg-card text-card-foreground shadow-sm transition-all duration-300 hover:shadow-glow">
                      <div class="p-8 text-center">
                        {
                          sponsor.logo ? (
                            <img
                              src={sponsor.logo}
                              alt={sponsor.name}
                              width={96}
                              height={96}
                              loading="lazy"
                              class="mx-auto mb-4 h-24 w-24 rounded-lg object-contain"
                            />
                          ) : (
                            <div class="mx-auto mb-4 flex h-24 w-24 items-center justify-center rounded-lg bg-muted">
                              <span class="text-sm font-semibold text-muted-foreground">{sponsor.name.charAt(0)}</span>
                            </div>
                          )
                        }
                        <h3 class="mb-2 text-xl font-bold text-foreground">{sponsor.name}</h3>
                        <div class="mb-2 flex items-center justify-center">
                          <span class:list={[badgeBase, getTierBadgeGradient(sponsor.tier), "flex flex-col items-center py-2 text-white"]}>
                            <span class="flex items-center">
                              <svg xmlns="http://www.w3.org/2000/svg" class="mr-1 h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={icons.star} />
                              {
                                tierLabel.subtitle ? (
                                  <span class="flex flex-col items-center">
                                    <span>{tierLabel.main}</span>
                                    <span class="text-sm">{tierLabel.subtitle}</span>
                                  </span>
                                ) : (
                                  tierLabel.main
                                )
                              }
                            </span>
                          </span>
                        </div>
                        {
                          sponsor.website && (
                            <a
                              href={sponsor.website}
                              target="_blank"
                              rel="noopener noreferrer"
                              class:list={["mt-2", outlineSmBtn]}
                            >
                              <svg xmlns="http://www.w3.org/2000/svg" class="mr-1 h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={icons.external} />
                              {partners.visitLabel}
                            </a>
                          )
                        }
                      </div>
                    </article>
                  );
                })
              }
            </div>
          </div>
        </section>
      )
    }

    <section class="bg-primary py-16 text-primary-foreground">
      <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
        <h2 class="mb-4 text-3xl font-bold">{cta.title}</h2>
        <p class="mb-8 text-xl opacity-90">{cta.subtitle}</p>
        <div class="flex flex-col justify-center gap-4 sm:flex-row">
          <button type="button" id="open-contact" class={secondaryBtn}>
            {cta.contactLabel}
          </button>
          <a href={hero.packetHref} target="_blank" rel="noopener noreferrer" class={secondaryBtn}>
            <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={icons.download} />
            {cta.downloadLabel}
          </a>
        </div>
      </div>
    </section>
  </div>

  <dialog
    id="contact-dialog"
    class="w-[calc(100%-2rem)] max-w-lg rounded-lg border border-border bg-card p-0 text-card-foreground shadow-lg backdrop:bg-black/50"
  >
    <form id="contact-form" class="p-6">
      <header class="mb-4">
        <h2 class="text-lg font-bold text-foreground">{contactDialog.title}</h2>
        <p class="mt-1 text-sm text-muted-foreground">{contactDialog.description}</p>
      </header>

      <div class="space-y-4">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label for="contact-name" class="mb-1 block text-sm font-medium text-foreground">{contactDialog.nameLabel} *</label>
            <input type="text" id="contact-name" name="name" required placeholder="Enter your name" class="flex h-10 w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40" />
          </div>
          <div>
            <label for="contact-email" class="mb-1 block text-sm font-medium text-foreground">{contactDialog.emailLabel} *</label>
            <input type="email" id="contact-email" name="email" required placeholder="Enter your email" class="flex h-10 w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40" />
          </div>
        </div>
        <div>
          <label for="contact-subject" class="mb-1 block text-sm font-medium text-foreground">{contactDialog.subjectLabel} *</label>
          <input type="text" id="contact-subject" name="subject" required value={cta.contactSubject} class="flex h-10 w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40" />
        </div>
        <div>
          <label for="contact-message" class="mb-1 block text-sm font-medium text-foreground">{contactDialog.messageLabel} *</label>
          <textarea id="contact-message" name="message" required rows={4} placeholder="Write your message here..." class="flex w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40"></textarea>
        </div>
      </div>

      <footer class="mt-6 flex justify-end gap-2">
        <button type="button" id="contact-cancel" class="inline-flex h-10 items-center justify-center rounded-md border border-border bg-background px-4 text-sm font-semibold text-foreground transition-colors hover:bg-muted">
          {contactDialog.cancel}
        </button>
        <button type="submit" class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90">
          <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={icons.send} />
          {contactDialog.send}
        </button>
      </footer>
    </form>
  </dialog>
</BaseLayout>

<script define:vars={{ siteEmail: site.email }}>
  const contactDialogEl = document.getElementById("contact-dialog");
  const contactForm = document.getElementById("contact-form");
  const openContact = document.getElementById("open-contact");
  const contactCancel = document.getElementById("contact-cancel");

  openContact?.addEventListener("click", () => contactDialogEl?.showModal());
  contactCancel?.addEventListener("click", () => contactDialogEl?.close());
  contactDialogEl?.addEventListener("click", (event) => {
    if (event.target === contactDialogEl) contactDialogEl.close();
  });

  contactForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    const formData = new FormData(contactForm);
    const name = String(formData.get("name") ?? "");
    const email = String(formData.get("email") ?? "");
    const subject = String(formData.get("subject") ?? "");
    const message = String(formData.get("message") ?? "");
    const body = encodeURIComponent(`From: ${name} (${email})\n\n${message}`);
    window.location.href = `mailto:${siteEmail}?subject=${encodeURIComponent(subject)}&body=${body}`;
    contactDialogEl?.close();
  });
</script>
