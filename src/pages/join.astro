---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionContainer from "../components/SectionContainer.astro";
import { joinPage } from "../data/joinPage";
import { site } from "../data/site";

const { hero, intro, tiersTitle, vipFaqTitle, fulfillmentTitle, membersTitle, tiers, vipFaq, fulfillmentFaq, memberGroups } =
  joinPage;

const tierIcons = {
  star: `<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />`,
  users: `<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />`,
  sparkles: `<path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z" /><path d="M20 3v4M22 5h-4M4 17v2M5 18H3" />`,
  crown: `<path d="M11.562 3.266a.5.5 0 0 1 .876 0L15.39 8.87a1 1 0 0 0 1.516.294L21.183 5.5a.5.5 0 0 1 .798.519l-2.834 10.246a1 1 0 0 1-.956.734H5.81a1 1 0 0 1-.957-.734L2.02 6.02a.5.5 0 0 1 .798-.519l4.276 3.664a1 1 0 0 0 1.516-.294z" /><path d="M5 21h14" />`,
};

function tierMailto(tierName: string) {
  return `mailto:${site.email}?subject=${encodeURIComponent(`${tierName} Membership`)}`;
}
---

<BaseLayout title="Join the Booster Club" description="Join the Round Rock Dragons basketball booster club and choose your membership tier.">
  <div class="min-h-screen bg-background font-sans">
    <section class="relative overflow-hidden bg-gradient-to-br from-primary via-primary/90 to-secondary py-4">
      <div class="pointer-events-none absolute inset-0 opacity-10" aria-hidden="true">
        <div
          class="absolute inset-0"
          style="background-image: url('data:image/svg+xml,%3Csvg width=\"60\" height=\"60\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"%3E%3Cg fill=\"none\" fill-rule=\"evenodd\"%3E%3Cg fill=\"%23ffffff\" fill-opacity=\"0.1\"%3E%3Ccircle cx=\"30\" cy=\"30\" r=\"2\"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E'); background-repeat: repeat;"
        >
        </div>
      </div>
      <div class="pointer-events-none absolute -right-8 -top-8 h-32 w-32 rounded-full bg-secondary/20 blur-xl" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -bottom-8 -left-8 h-24 w-24 rounded-full bg-primary-foreground/10 blur-xl" aria-hidden="true"></div>

      <SectionContainer class="relative z-10">
        <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-3">
          <div class="hidden justify-center lg:flex">
            <img src="/official-logo.png" alt="" class="h-16 w-auto animate-pulse object-contain drop-shadow-2xl" aria-hidden="true" />
          </div>
          <div class="text-center">
            <h1 class="font-display text-2xl font-black uppercase tracking-wider text-primary-foreground text-shadow md:text-3xl lg:text-4xl">
              {hero.title}
            </h1>
            <p class="mt-3 text-lg font-medium text-primary-foreground/90 text-shadow md:text-xl">
              {hero.subtitle}
            </p>
          </div>
          <div class="hidden justify-center lg:flex">
            <img
              src="/official-logo.png"
              alt=""
              class="h-16 w-auto animate-pulse object-contain drop-shadow-2xl"
              style="animation-delay: 1s"
              aria-hidden="true"
            />
          </div>
        </div>
        <div class="mt-4 flex justify-center lg:hidden">
          <img src="/official-logo.png" alt="" class="h-12 w-auto object-contain drop-shadow-xl" aria-hidden="true" />
        </div>
      </SectionContainer>
    </section>

    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="mb-12 space-y-4 text-center">
        {
          intro.map((line) => (
            <p class="mx-auto max-w-3xl text-lg text-muted-foreground">{line}</p>
          ))
        }
      </div>

      <section class="mb-16">
        <h2 class="mb-8 text-center text-3xl font-bold text-foreground">{tiersTitle}</h2>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
          {
            tiers.map((tier) => (
              <article
                class:list={[
                  "relative flex flex-col rounded-lg border bg-card text-card-foreground shadow-sm",
                  tier.badge ? "border-primary shadow-lg" : "border-border",
                ]}
              >
                {
                  tier.badge && (
                    <div class="absolute -top-3 left-1/2 flex -translate-x-1/2 gap-2">
                      {
                        tier.badge === "most-popular" && (
                          <span class="inline-flex items-center rounded-md bg-primary px-2 py-1 text-xs font-semibold text-primary-foreground">
                            Most Popular
                          </span>
                        )
                      }
                      {
                        tier.badge === "limited" && (
                          <span class="inline-flex items-center rounded-md bg-orange-500 px-2 py-1 text-xs font-semibold text-white">
                            Limited Offering
                          </span>
                        )
                      }
                    </div>
                  )
                }

                <header class="p-6 pb-0">
                  <div class="mb-2 flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={tierIcons[tier.icon]} />
                    <h3 class="text-lg font-semibold leading-none tracking-tight text-foreground">{tier.name}</h3>
                  </div>
                  <p class="text-sm text-muted-foreground">{tier.headline}</p>
                  <p class="mt-4 text-3xl font-bold text-primary">{tier.price}</p>
                </header>

                <div class="flex-1 space-y-2 p-6 pt-4">
                  {
                    tier.benefits.map((benefit) => (
                      <div class="flex items-start gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="mt-1 h-4 w-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                          <path d="M21.801 10A10 10 0 1 1 17 3.335" /><path d="m9 11 3 3L22 4" />
                        </svg>
                        <span class="text-sm text-foreground">{benefit}</span>
                      </div>
                    ))
                  }
                  {
                    tier.includesVipParking && (
                      <div class="flex items-start gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="mt-1 h-4 w-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                          <path d="M21.801 10A10 10 0 1 1 17 3.335" /><path d="m9 11 3 3L22 4" />
                        </svg>
                        <span class="text-sm font-medium text-foreground">VIP Parking Included</span>
                      </div>
                    )
                  }
                </div>

                <footer class="p-6 pt-0">
                  <a
                    href={tierMailto(tier.name)}
                    class="inline-flex h-11 w-full items-center justify-center rounded-md bg-primary px-8 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
                  >
                    {tier.ctaLabel}
                  </a>
                </footer>
              </article>
            ))
          }
        </div>
      </section>

      <section class="mb-16">
        <h2 class="mb-8 text-center text-3xl font-bold text-foreground">{vipFaqTitle}</h2>
        <div class="join-accordion mx-auto max-w-3xl">
          {
            vipFaq.map((item) => (
              <details class="group border-b border-border">
                <summary class="flex cursor-pointer list-none items-center justify-between py-4 text-left text-sm font-medium text-foreground transition-colors hover:underline [&::-webkit-details-marker]:hidden">
                  {item.title}
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </summary>
                <div class="pb-4 text-sm text-muted-foreground">{item.body}</div>
              </details>
            ))
          }
        </div>
      </section>

      <section class="mb-16">
        <h2 class="mb-8 text-center text-3xl font-bold text-foreground">{fulfillmentTitle}</h2>
        <div class="join-accordion mx-auto max-w-3xl">
          {
            fulfillmentFaq.map((item) => (
              <details class="group border-b border-border">
                <summary class="flex cursor-pointer list-none items-center justify-between py-4 text-left text-sm font-medium text-foreground transition-colors hover:underline [&::-webkit-details-marker]:hidden">
                  {item.title}
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </summary>
                <div class="pb-4 text-sm text-muted-foreground">{item.body}</div>
              </details>
            ))
          }
        </div>
      </section>

      <section class="mb-16">
        <h2 class="mb-8 text-center text-3xl font-bold text-foreground">{membersTitle}</h2>
        {
          memberGroups.map((group) => (
            <div class="mb-8">
              <h3 class="mb-4 flex items-center gap-2 text-xl font-semibold capitalize text-foreground">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={tierIcons[group.icon]} />
                {group.label} Members
              </h3>
              <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
                {
                  group.members.map((name) => (
                    <article class="rounded-lg border border-border bg-card p-4 shadow-sm">
                      <p class="text-center font-medium text-foreground">{name}</p>
                    </article>
                  ))
                }
              </div>
            </div>
          ))
        }
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .join-accordion details + details {
    border-top: 0;
  }
</style>
