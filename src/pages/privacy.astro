---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
---

<BaseLayout title="Privacy Policy">
  <PageHero title="Privacy Policy" />

  <section class="py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 prose prose-gray">
      <p>
        The Round Rock High School Boys Basketball Booster Club respects your privacy. We collect only the
        information needed to process orders, membership, and communications related to our program.
      </p>
      <p>
        Payment information is processed securely by Square and is never stored on our servers. Contact
        information submitted through email or forms is used solely for booster club purposes.
      </p>
      <p>
        For questions about this policy, contact boosterclub@roundrockbasketball.org.
      </p>
    </div>
  </section>
</BaseLayout>
