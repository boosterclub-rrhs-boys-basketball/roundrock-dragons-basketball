---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { members } from "../data/members";
---

<BaseLayout title="Members" description="Meet the Round Rock Dragons booster club members.">
  <PageHero
    title="Our Members"
    subtitle="The families and supporters who make our program possible"
  />

  <section class="py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      {
        members.map((member) => (
          <blockquote class="rounded-2xl bg-white border border-gray-200 p-8 shadow-sm">
            <span class="inline-block px-3 py-1 rounded-full bg-dragon-maroon/10 text-dragon-maroon text-xs font-bold uppercase">
              {member.tier}
            </span>
            <h2 class="font-display text-2xl font-bold mt-4">{member.name}</h2>
            <p class="mt-4 text-gray-600 leading-relaxed text-lg">{member.quote}</p>
          </blockquote>
        ))
      }
    </div>
  </section>

  <section class="py-12 bg-dragon-maroon text-white text-center">
    <div class="max-w-2xl mx-auto px-4">
      <h2 class="font-display text-2xl font-bold">Become a Member</h2>
      <p class="mt-3 text-white/90">Join the booster club and help support our student-athletes.</p>
      <a href="/join" class="inline-flex mt-6 px-6 py-3 rounded-md bg-white text-dragon-maroon font-bold">
        Join Today
      </a>
    </div>
  </section>
</BaseLayout>
