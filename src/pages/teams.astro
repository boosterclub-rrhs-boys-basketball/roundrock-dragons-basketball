---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { teams } from "../data/teams";
---

<BaseLayout title="Our Teams" description="Meet the Round Rock Dragons basketball teams.">
  <PageHero
    title="Our Teams"
    subtitle="Meet the Dragons basketball family - where champions are made"
  />

  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      {
        teams.map((team) => (
          <article class="rounded-2xl border border-gray-200 overflow-hidden shadow-sm">
            <div class="bg-dragon-maroon text-white px-6 py-4 flex flex-wrap justify-between gap-2">
              <div>
                <h2 class="font-display text-2xl font-bold">{team.name}</h2>
                <p class="text-white/80">{team.level}</p>
              </div>
              <div class="text-right">
                <p class="text-sm text-white/80">Record</p>
                <p class="font-display text-xl font-bold">{team.record}</p>
              </div>
            </div>
            <div class="p-6 grid md:grid-cols-2 gap-6">
              <div>
                <p class="text-gray-600">{team.description}</p>
                <p class="mt-4">
                  <span class="font-semibold">Coach:</span> {team.coach}
                </p>
                <div class="mt-6 flex gap-3">
                  <a href="/schedule" class="px-4 py-2 rounded-md bg-dragon-maroon text-white text-sm font-bold">
                    Schedule
                  </a>
                </div>
              </div>
              <div>
                <h3 class="font-display text-lg font-bold text-dragon-maroon mb-3">Key Achievements</h3>
                <ul class="space-y-2">
                  {team.achievements.map((item) => (
                    <li class="flex items-start gap-2 text-gray-600">
                      <span class="text-dragon-maroon mt-1">•</span>
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="py-12 bg-gray-50 text-center">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="font-display text-2xl font-bold text-dragon-maroon">Want to Join the Dragons?</h2>
      <p class="mt-3 text-gray-600">Learn about tryouts, training camps, and how to become part of our basketball family.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <a href="/help" class="px-6 py-3 rounded-md bg-dragon-maroon text-white font-bold">Tryout Information</a>
        <a href="/coaches" class="px-6 py-3 rounded-md border-2 border-dragon-maroon text-dragon-maroon font-bold">Contact Coaches</a>
      </div>
    </div>
  </section>
</BaseLayout>
