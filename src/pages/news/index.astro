---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { newsArticles, formatNewsDate } from "../../data/news";
---

<BaseLayout title="News & Media" description="Latest Round Rock Dragons basketball news and highlights.">
  <PageHero title="News & Media" subtitle="Stay updated with the latest Dragons basketball news and highlights" />

  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {
          newsArticles.map((article) => (
            <article class="rounded-xl border border-gray-200 overflow-hidden shadow-sm flex flex-col">
              <div class="p-6 flex-1 flex flex-col">
                <span class="text-xs uppercase tracking-wide text-dragon-maroon font-bold">{article.category}</span>
                <time class="text-sm text-gray-500 mt-2">{formatNewsDate(article.date)}</time>
                <h2 class="font-display text-xl font-bold mt-3">{article.title}</h2>
                <p class="text-gray-600 mt-3 flex-1">{article.excerpt}</p>
                <a href={`/news/${article.id}`} class="mt-4 text-dragon-maroon font-semibold hover:underline">
                  Read More
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
