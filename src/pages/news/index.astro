---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import NewsCard from "../../components/NewsCard.astro";
import { newsArticles } from "../../data/news";
---

<BaseLayout title="News & Media" description="Latest Round Rock Dragons basketball news and highlights.">
  <PageHero title="News & Media" subtitle="Stay updated with the latest Dragons basketball news and highlights" />

  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {newsArticles.map((article) => <NewsCard article={article} />)}
      </div>
    </div>
  </section>
</BaseLayout>
